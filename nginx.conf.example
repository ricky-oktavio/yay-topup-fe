# Contoh Konfigurasi Nginx untuk VPS (YayTopup Frontend)
# Letakkan di /etc/nginx/sites-available/yaytopup lalu symlink ke sites-enabled

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com; # Ganti dengan domain atau IP VPS Anda

    root /var/www/yaytopup; # Ganti dengan lokasi folder dist hasil 'npm run build'
    index index.html;

    # 1. SPA Routing (Mencegah 404 saat refresh halaman)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Reverse Proxy API (Mencegah CORS & Network Error di VPS)
    location /api/v1/ {
        proxy_pass https://api.yaytopup.my.id/api/v1/;
        proxy_ssl_server_name on;
        proxy_set_header Host api.yaytopup.my.id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Cache static assets (CSS, JS, Images)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }
}
